From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mac-gaming <noreply@github.com>
Date: Fri, 27 Nov 2026 07:03:47 +0000
Subject: [PATCH] [d3d9] Fix build with mingw-w64 13+ headers

mingw-w64 13 imports d3d9types.h from Wine 10.3, which defines
D3DDEVINFO_RESOURCEMANAGER, so only provide the fallback for older headers.
---
 src/d3d9/d3d9_include.h | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/d3d9/d3d9_include.h b/src/d3d9/d3d9_include.h
index 8762265..78b9fcd 100644
--- a/src/d3d9/d3d9_include.h
+++ b/src/d3d9/d3d9_include.h
@@ -79,10 +79,13 @@
 
 // MinGW headers are broken. Who'dve guessed?
 #ifndef _MSC_VER
+// mingw-w64 13+ ships this struct (headers imported from Wine 10.3).
+#if !defined(__MINGW64_VERSION_MAJOR) || __MINGW64_VERSION_MAJOR < 13
 typedef struct _D3DDEVINFO_RESOURCEMANAGER
 {
   char dummy;
 } D3DDEVINFO_RESOURCEMANAGER, * LPD3DDEVINFO_RESOURCEMANAGER;
+#endif
 
 #ifndef __WINE__
 extern "C" WINUSERAPI WINBOOL WINAPI SetProcessDPIAware(VOID);
